#!/usr/bin/env bash
set -euo pipefail

# pi-sandbox-run: run an existing Pi sandbox image. It never builds images.

SCRIPT_PATH="$(realpath -e -- "${BASH_SOURCE[0]}")" || { printf 'error: cannot resolve script path\n' >&2; exit 1; }
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
HELP_FILE="${SCRIPT_DIR}/docs/pi-sandbox-run.md"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
XDG_BIN_HOME="${XDG_BIN_HOME:-${HOME}/.local/bin}"
CONFIG_DIR="${XDG_CONFIG_HOME}/pi-sandbox"
CONFIG_FILE="${CONFIG_DIR}/config"
ALLOWED_ROOTS_FILE="${CONFIG_DIR}/allowed-roots"

IMAGE="pi-sandbox:latest"
CONTAINER_USER="pi"
CONTAINER_UID=1000
CONTAINER_GID=1000
CONTAINER_HOME="/home/pi"
CONTAINER_START_DIR=""
AGENT_VOLUME="pi-agent"
MEMORY=""
CPUS=""
PIDS_LIMIT=512
ENV_FILE=""
NETWORK_MODE="default"
VERBOSE=0

PROFILE=""
INSTANCE_NAME=""
HOST_WORKSPACE=""
SHELL_MODE=0
DRY_RUN=0
SHOW_INFO=0
SHOW_STATE=0
RESET_STATE=0
YES=0
STATE_VOLUME_SET=0
EXTRA_MOUNTS=()
ALLOWED_ROOTS=()
PI_ARGS=()

usage() {
    if [[ -r "$HELP_FILE" ]]; then
        cat "$HELP_FILE"
    else
        printf 'error: help file not found: %s\n' "$HELP_FILE" >&2
        return 1
    fi
}

err() { printf 'error: %s\n' "$*" >&2; }
warn() { printf 'warning: %s\n' "$*" >&2; }
log() { printf '==> %s\n' "$*"; }

shell_join() { local out="" q arg; for arg in "$@"; do printf -v q '%q' "$arg"; out+="${out:+ }${q}"; done; printf '%s\n' "$out"; }
run_cmd() { if (( VERBOSE || DRY_RUN )); then printf '+ '; shell_join "$@"; fi; (( DRY_RUN )) && return 0; "$@"; }

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

write_default_config() {
    mkdir -p -- "$(dirname -- "$CONFIG_FILE")"
    cat > "$CONFIG_FILE" <<EOF
# pi-sandbox runtime configuration
CONTAINER_USER=${CONTAINER_USER}
CONTAINER_UID=${CONTAINER_UID}
CONTAINER_GID=${CONTAINER_GID}
CONTAINER_HOME=${CONTAINER_HOME}
STATE_VOLUME=${AGENT_VOLUME}
MEMORY=${MEMORY}
CPUS=${CPUS}
PIDS_LIMIT=${PIDS_LIMIT}
ENV_FILE=${ENV_FILE}
NETWORK_MODE=${NETWORK_MODE}
VERBOSE=${VERBOSE}
# MOUNT=/host/path:/container/path:ro
EOF
}

write_default_allowed_roots() {
    local default_root="${HOME}/src"

    mkdir -p -- "$(dirname -- "$ALLOWED_ROOTS_FILE")"
    if [[ ! -e "$default_root" ]]; then
        mkdir -p -- "$default_root"
    fi
    [[ -d "$default_root" && ! -L "$default_root" ]] || {
        err "default allowed root must be a non-symlinked directory: $default_root"
        exit 1
    }
    cat > "$ALLOWED_ROOTS_FILE" <<'EOF'
# pi-sandbox allowed bind-mount roots
# One directory path relative to $HOME per line. Edit this file by hand.
# The listed roots must exist and must not contain hidden, '.', '..', or
# symbolic-link path components. A mounted directory must be below a root;
# the root directory itself cannot be mounted.
src
EOF
}

load_allowed_roots() {
    [[ -f "$ALLOWED_ROOTS_FILE" ]] || write_default_allowed_roots

    local line entry candidate canonical home_canonical component existing lineno=0 duplicate
    local -a components
    home_canonical="$(realpath -e -- "$HOME")" || { err "cannot resolve HOME: $HOME"; exit 1; }
    [[ -d "$home_canonical" ]] || { err "HOME is not a directory: $HOME"; exit 1; }
    ALLOWED_ROOTS=()

    while IFS= read -r line || [[ -n "$line" ]]; do
        ((++lineno))
        entry="$(trim "$line")"
        [[ -z "$entry" || "$entry" == \#* ]] && continue
        [[ "$entry" != /* ]] || { err "$ALLOWED_ROOTS_FILE:$lineno: entry must be relative to HOME: $entry"; exit 2; }
        while [[ "$entry" == */ ]]; do entry="${entry%/}"; done
        [[ -n "$entry" ]] || { err "$ALLOWED_ROOTS_FILE:$lineno: empty root is not allowed"; exit 2; }
        [[ "$entry" != *"//"* ]] || { err "$ALLOWED_ROOTS_FILE:$lineno: empty path component: $entry"; exit 2; }

        IFS='/' read -r -a components <<< "$entry"
        for component in "${components[@]}"; do
            [[ -n "$component" && "$component" != "." && "$component" != ".." ]] || {
                err "$ALLOWED_ROOTS_FILE:$lineno: path traversal is not allowed: $entry"
                exit 2
            }
            [[ "$component" != .* ]] || {
                err "$ALLOWED_ROOTS_FILE:$lineno: hidden directory is not allowed: $entry"
                exit 2
            }
        done

        candidate="${home_canonical}/${entry}"
        [[ -e "$candidate" ]] || { err "$ALLOWED_ROOTS_FILE:$lineno: directory does not exist: $candidate"; exit 2; }
        [[ -d "$candidate" ]] || { err "$ALLOWED_ROOTS_FILE:$lineno: entry is not a directory: $candidate"; exit 2; }
        [[ ! -L "$candidate" ]] || { err "$ALLOWED_ROOTS_FILE:$lineno: symbolic link is not allowed: $candidate"; exit 2; }
        canonical="$(realpath -e -- "$candidate")" || { err "$ALLOWED_ROOTS_FILE:$lineno: cannot resolve: $candidate"; exit 2; }
        [[ "$canonical" == "$candidate" && "$canonical" == "$home_canonical/"* ]] || {
            err "$ALLOWED_ROOTS_FILE:$lineno: entry escapes HOME or contains a symbolic link: $entry"
            exit 2
        }

        duplicate=0
        for existing in "${ALLOWED_ROOTS[@]}"; do
            if [[ "$existing" == "$canonical" ]]; then duplicate=1; fi
        done
        if (( ! duplicate )); then ALLOWED_ROOTS+=("$canonical"); fi
    done < "$ALLOWED_ROOTS_FILE"
}

load_config() {
    [[ -f "$CONFIG_FILE" ]] || { write_default_config; return 0; }
    local line key value lineno=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        ((++lineno))
        line="$(trim "$line")"
        [[ -z "$line" || "$line" == \#* ]] && continue
        [[ "$line" == *=* ]] || { err "$CONFIG_FILE:$lineno: expected KEY=VALUE"; exit 2; }
        key="$(trim "${line%%=*}")"; value="$(trim "${line#*=}")"
        if [[ "$value" == \"*\" && "$value" == *\" ]]; then value="${value:1:${#value}-2}"; fi
        if [[ "$value" == \'*\' && "$value" == *\' ]]; then value="${value:1:${#value}-2}"; fi
        case "$key" in
            IMAGE) IMAGE="$value" ;;
            CONTAINER_USER) CONTAINER_USER="$value" ;;
            CONTAINER_UID) CONTAINER_UID="$value" ;;
            CONTAINER_GID) CONTAINER_GID="$value" ;;
            CONTAINER_HOME) CONTAINER_HOME="$value" ;;
            STATE_VOLUME|AGENT_VOLUME) AGENT_VOLUME="$value" ;;
            MEMORY) MEMORY="$value" ;;
            CPUS) CPUS="$value" ;;
            PIDS_LIMIT) PIDS_LIMIT="$value" ;;
            ENV_FILE) ENV_FILE="$value" ;;
            NETWORK_MODE) NETWORK_MODE="$value" ;;
            MOUNT) EXTRA_MOUNTS+=("$value") ;;
            VERBOSE) [[ "$value" =~ ^(1|true|yes)$ ]] && VERBOSE=1 ;;
            BASE_IMAGE|PI_VERSION|PROFILE_DIR) : ;; # creator settings; ignored by runner
            *) err "$CONFIG_FILE:$lineno: unsupported config key '$key'"; exit 2 ;;
        esac
    done < "$CONFIG_FILE"
}

require_podman() {
    command -v podman >/dev/null 2>&1 || { err "podman is not installed or not in PATH"; exit 1; }
    (( DRY_RUN )) && return 0
    podman info >/dev/null 2>&1 || { err "Podman is installed but 'podman info' failed"; exit 1; }
}

confirm() {
    (( YES )) && return 0
    [[ -t 0 ]] || { err "$1 requires confirmation; rerun with --yes"; return 1; }
    local answer
    read -r -p "$1 [y/N] " answer
    [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]
}

resolve_link_target() {
    local link="$1" target
    target="$(readlink -- "$link")" || return 1
    if [[ "$target" != /* ]]; then target="$(dirname -- "$link")/$target"; fi
    realpath -m -- "$target"
}

install_user_links() {
    local name target destination existing
    local -a names=(pi-sandbox-create pi-sandbox-run)

    [[ "$XDG_BIN_HOME" == /* ]] || { err "XDG_BIN_HOME must be an absolute path: $XDG_BIN_HOME"; return 1; }

    # Preflight every destination before changing anything.
    for name in "${names[@]}"; do
        target="${SCRIPT_DIR}/${name}"
        destination="${XDG_BIN_HOME}/${name}"
        [[ -x "$target" ]] || { err "installation target is missing or not executable: $target"; return 1; }
        if [[ -e "$destination" || -L "$destination" ]]; then
            if [[ ! -L "$destination" ]]; then
                err "refusing to replace non-symlink: $destination"
                return 1
            fi
            existing="$(resolve_link_target "$destination")" || { err "cannot inspect symlink: $destination"; return 1; }
            [[ "$existing" == "$target" ]] || {
                err "refusing to replace unrelated symlink: $destination -> $(readlink -- "$destination")"
                return 1
            }
        fi
    done

    mkdir -p -- "$XDG_BIN_HOME"
    for name in "${names[@]}"; do
        target="${SCRIPT_DIR}/${name}"
        destination="${XDG_BIN_HOME}/${name}"
        ln -sfn -- "$target" "$destination"
        printf 'installed: %s -> %s\n' "$destination" "$target"
    done

    case ":${PATH}:" in
        *":${XDG_BIN_HOME}:"*) ;;
        *) warn "${XDG_BIN_HOME} is not in PATH" ;;
    esac
}

remove_user_links() {
    local name target destination existing
    local -a names=(pi-sandbox-create pi-sandbox-run)

    [[ "$XDG_BIN_HOME" == /* ]] || { err "XDG_BIN_HOME must be an absolute path: $XDG_BIN_HOME"; return 1; }

    for name in "${names[@]}"; do
        target="${SCRIPT_DIR}/${name}"
        destination="${XDG_BIN_HOME}/${name}"
        if [[ ! -e "$destination" && ! -L "$destination" ]]; then
            printf 'not installed: %s\n' "$destination"
            continue
        fi
        if [[ ! -L "$destination" ]]; then
            warn "not removing non-symlink: $destination"
            continue
        fi
        existing="$(resolve_link_target "$destination")" || { warn "cannot inspect symlink: $destination"; continue; }
        if [[ "$existing" != "$target" ]]; then
            warn "not removing unrelated symlink: $destination -> $(readlink -- "$destination")"
            continue
        fi
        rm -- "$destination"
        printf 'removed: %s\n' "$destination"
    done
}

# Set by validate_host_directory on success.
VALIDATED_PATH=""

# Validate only the directory selected as the bind source and the components of
# its path. Contents below that directory are deliberately not inspected; they
# may contain hidden entries, files, or symbolic links.
validate_host_directory() {
    local source="$1" description="$2" root relative component canonical home_canonical allowed_roots_display
    local -a components

    if [[ "$source" == ./* ]]; then
        source="${PWD%/}/${source#./}"
    elif [[ "$source" != /* ]]; then
        err "$description must be an absolute path or start with './': $source"
        return 1
    fi
    [[ "$source" != "/" ]] || { err "$description cannot be the filesystem root"; return 1; }

    # A trailing slash is harmless; all other non-canonical syntax is rejected.
    while [[ "$source" != "/" && "$source" == */ ]]; do source="${source%/}"; done
    [[ "$source" != *"//"* ]] || { err "$description contains an empty path component: $source"; return 1; }

    if [[ ! -e "$source" ]]; then
        err "$description does not exist: $source"
        return 1
    fi
    [[ -d "$source" ]] || { err "$description must be a directory, not a file: $source"; return 1; }
    [[ ! -L "$source" ]] || { err "$description cannot be a symbolic link: $source"; return 1; }

    canonical="$(realpath -e -- "$source")" || { err "cannot resolve $description: $source"; return 1; }
    [[ "$canonical" == "$source" ]] || {
        err "$description must not contain symbolic links, '.' or '..': $source"
        return 1
    }
    home_canonical="$(realpath -e -- "$HOME")" || { err "cannot resolve HOME: $HOME"; return 1; }
    [[ "$canonical" != "$home_canonical" ]] || {
        err "$description cannot be the whole HOME directory: $canonical"
        return 1
    }

    relative=""
    for root in "${ALLOWED_ROOTS[@]}"; do
        if [[ "$canonical" == "$root/"* ]]; then
            relative="${canonical#"$root/"}"
            break
        fi
    done
    if [[ -z "$relative" ]]; then
        if ((${#ALLOWED_ROOTS[@]})); then
            allowed_roots_display="$(printf '%s, ' "${ALLOWED_ROOTS[@]}")"
            allowed_roots_display="${allowed_roots_display%, }"
        else
            allowed_roots_display="none configured"
        fi
        err "$description must be below an allowed root ($allowed_roots_display): $canonical"
        return 1
    fi

    IFS='/' read -r -a components <<< "$relative"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || { err "$description contains an empty path component: $canonical"; return 1; }
        [[ "$component" != "." && "$component" != ".." ]] || {
            err "$description contains path traversal: $canonical"
            return 1
        }
        [[ "$component" != .* ]] || {
            err "$description contains hidden directory '.${component#.}': $canonical"
            return 1
        }
    done

    VALIDATED_PATH="$canonical"
}

validate_container_mountpoint() {
    local target="$1" component
    local -a components

    [[ "$target" == /* ]] || { err "mount destination must be an absolute path: $target"; return 1; }
    [[ "$target" != "/" ]] || { err "mount destination cannot be the container root"; return 1; }
    [[ "$target" != *"//"* ]] || { err "mount destination contains an empty path component: $target"; return 1; }

    IFS='/' read -r -a components <<< "${target#/}"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || { err "mount destination contains an empty path component: $target"; return 1; }
        [[ "$component" != "." && "$component" != ".." ]] || {
            err "mount destination contains path traversal: $target"
            return 1
        }
        [[ "$component" != .* ]] || {
            err "mount destination contains a hidden directory: $target"
            return 1
        }
    done
}

resolve_workspace() {
    local workspace_name

    HOST_WORKSPACE="${HOST_WORKSPACE:-$PWD}"
    validate_host_directory "$HOST_WORKSPACE" "workspace" || return 1
    HOST_WORKSPACE="$VALIDATED_PATH"
    workspace_name="${HOST_WORKSPACE##*/}"
    CONTAINER_START_DIR="${CONTAINER_HOME%/}/${workspace_name}"
    validate_container_mountpoint "$CONTAINER_START_DIR" || return 1
}

validate_mount_spec() {
    local spec="$1" source remainder target options=""

    [[ "$spec" == *:* ]] || { err "invalid --mount '$spec'; expected HOST:CONTAINER[:ro|rw]"; return 1; }
    source="${spec%%:*}"
    remainder="${spec#*:}"
    target="${remainder%%:*}"
    if [[ "$remainder" == *:* ]]; then
        options="${remainder#*:}"
        [[ "$options" != *:* ]] || { err "invalid --mount options in '$spec'"; return 1; }
        [[ "$options" == "ro" || "$options" == "rw" ]] || {
            err "mount options must be 'ro' or 'rw': $spec"
            return 1
        }
    fi

    validate_host_directory "$source" "mount source" || return 1
    source="$VALIDATED_PATH"
    validate_container_mountpoint "$target" || return 1
    VALIDATED_PATH="${source}:${target}${options:+:${options}}"
}

if [[ ${1:-} == "--install" || ${1:-} == "--remove" ]]; then
    [[ $# -eq 1 ]] || { err "${1} cannot be combined with other arguments"; exit 2; }
    if [[ "$1" == "--install" ]]; then install_user_links; else remove_user_links; fi
    exit $?
fi
if [[ $# -eq 1 && ( ${1:-} == "--help" || ${1:-} == "-h" ) ]]; then
    usage
    exit 0
fi

# Find --config before loading configuration so CLI can select another file.
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
    if [[ "${args[i]}" == "--config" ]]; then
        (( i + 1 < ${#args[@]} )) || { err "--config requires FILE"; exit 2; }
        CONFIG_FILE="${args[i+1]}"
        ALLOWED_ROOTS_FILE="$(dirname -- "$CONFIG_FILE")/allowed-roots"
    fi
done

load_config
load_allowed_roots

if [[ $# -gt 0 && "$1" != -* ]]; then
    PROFILE="$1"
    shift
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --) shift; PI_ARGS+=("$@"); break ;;
        --name) [[ $# -ge 2 ]] || { err "$1 requires NAME"; exit 2; }; INSTANCE_NAME="$2"; shift ;;
        --workspace) [[ $# -ge 2 ]] || { err "$1 requires DIRECTORY"; exit 2; }; HOST_WORKSPACE="$2"; shift ;;
        --mount) [[ $# -ge 2 ]] || { err "$1 requires SPEC"; exit 2; }; EXTRA_MOUNTS+=("$2"); shift ;;
        --env-file) [[ $# -ge 2 ]] || { err "$1 requires FILE"; exit 2; }; ENV_FILE="$2"; shift ;;
        --state-volume) [[ $# -ge 2 ]] || { err "$1 requires NAME"; exit 2; }; AGENT_VOLUME="$2"; STATE_VOLUME_SET=1; shift ;;
        --memory) [[ $# -ge 2 ]] || { err "$1 requires SIZE"; exit 2; }; MEMORY="$2"; shift ;;
        --cpus) [[ $# -ge 2 ]] || { err "$1 requires NUMBER"; exit 2; }; CPUS="$2"; shift ;;
        --pids-limit) [[ $# -ge 2 ]] || { err "$1 requires NUMBER"; exit 2; }; PIDS_LIMIT="$2"; shift ;;
        --no-network) NETWORK_MODE="none" ;;
        --shell) SHELL_MODE=1 ;;
        --image) [[ $# -ge 2 ]] || { err "$1 requires IMAGE"; exit 2; }; IMAGE="$2"; PROFILE=""; shift ;;
        --show-state) SHOW_STATE=1 ;;
        --reset-state) RESET_STATE=1 ;;
        --info) SHOW_INFO=1 ;;
        --dry-run) DRY_RUN=1 ;;
        --verbose|--debug) VERBOSE=1 ;;
        --yes|-y) YES=1 ;;
        --config) [[ $# -ge 2 ]] || { err "$1 requires FILE"; exit 2; }; CONFIG_FILE="$2"; shift ;;
        --help|-h) usage; exit 0 ;;
        *)
            if [[ "$1" != -* && -z "$PROFILE" ]]; then
                PROFILE="$1"
            else
                err "unknown option: $1"; usage >&2; exit 2
            fi
            ;;
    esac
    shift
done

[[ -z "$PROFILE" || "$PROFILE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { err "invalid profile name '$PROFILE'"; exit 2; }
[[ -z "$INSTANCE_NAME" || "$INSTANCE_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { err "invalid sandbox name '$INSTANCE_NAME'"; exit 2; }
[[ "$CONTAINER_UID" =~ ^[0-9]+$ ]] || { err "container UID must be numeric"; exit 2; }
[[ "$CONTAINER_GID" =~ ^[0-9]+$ ]] || { err "container GID must be numeric"; exit 2; }
[[ "$PIDS_LIMIT" =~ ^[0-9]+$ ]] || { err "pids limit must be numeric"; exit 2; }
[[ "$CONTAINER_HOME" == /* ]] || { err "container home must be an absolute path"; exit 2; }

if [[ -n "$PROFILE" ]]; then
    IMAGE="pi-sandbox-${PROFILE}:latest"
    (( STATE_VOLUME_SET )) || AGENT_VOLUME="pi-agent-${PROFILE}${INSTANCE_NAME:+-${INSTANCE_NAME}}"
elif [[ "$AGENT_VOLUME" == "pi-agent" && -n "$INSTANCE_NAME" && $STATE_VOLUME_SET -eq 0 ]]; then
    AGENT_VOLUME="pi-agent-${INSTANCE_NAME}"
fi

require_podman

if (( SHOW_INFO )); then
    resolve_workspace || exit 2
    echo "pi-sandbox runtime configuration"
    printf '  profile:             %s\n' "${PROFILE:-default}"
    printf '  image:               %s\n' "$IMAGE"
    printf '  container user:      %s (%s:%s)\n' "$CONTAINER_USER" "$CONTAINER_UID" "$CONTAINER_GID"
    printf '  container start dir: %s\n' "$CONTAINER_START_DIR"
    printf '  host start dir:      %s\n' "${HOST_WORKSPACE:-$PWD}"
    printf '  state volume:        %s\n' "$AGENT_VOLUME"
    printf '  network:             %s\n' "$NETWORK_MODE"
    printf '  extra mounts:        %s\n' "${EXTRA_MOUNTS[*]:-none}"
    printf '  allowed-roots file:  %s\n' "$ALLOWED_ROOTS_FILE"
    printf '  allowed roots:       %s\n' "${ALLOWED_ROOTS[*]:-none}"
    if command -v podman >/dev/null 2>&1 && podman image exists "$IMAGE" 2>/dev/null; then
        printf '  image status:        present\n'
    else
        printf '  image status:        missing\n'
    fi
    exit 0
fi

if (( SHOW_STATE )); then
    if (( DRY_RUN )); then echo "+ podman volume inspect $(printf '%q' "$AGENT_VOLUME")"; exit 0; fi
    if podman volume exists "$AGENT_VOLUME"; then podman volume inspect "$AGENT_VOLUME"; else echo "State volume '$AGENT_VOLUME' does not exist."; fi
    exit 0
fi

if (( RESET_STATE )); then
    if (( DRY_RUN )); then echo "+ podman volume rm $(printf '%q' "$AGENT_VOLUME")"; exit 0; fi
    if podman volume exists "$AGENT_VOLUME"; then
        confirm "Remove Pi state volume '$AGENT_VOLUME'? This deletes saved state." || exit 1
        run_cmd podman volume rm "$AGENT_VOLUME" >/dev/null
        echo "Removed state volume '$AGENT_VOLUME'."
    else
        echo "State volume '$AGENT_VOLUME' does not exist."
    fi
    exit 0
fi

if (( DRY_RUN )); then
    echo "# Require existing image: $IMAGE"
elif ! podman image exists "$IMAGE"; then
    err "sandbox image '$IMAGE' does not exist"
    err "ask an administrator to create it with: pi-sandbox-create${PROFILE:+ $PROFILE} --build"
    exit 1
fi

resolve_workspace || exit 2

VALIDATED_MOUNTS=()
for mount in "${EXTRA_MOUNTS[@]}"; do
    validate_mount_spec "$mount" || exit 2
    VALIDATED_MOUNTS+=("$VALIDATED_PATH")
done

if (( ! DRY_RUN )) && ! podman volume exists "$AGENT_VOLUME"; then
    log "Creating Pi state volume: $AGENT_VOLUME"
    run_cmd podman volume create "$AGENT_VOLUME" >/dev/null
elif (( DRY_RUN )); then
    echo "# Ensure state volume exists: $AGENT_VOLUME"
fi

RUN_ARGS=(
    --rm --interactive --tty
    --userns="keep-id:uid=${CONTAINER_UID},gid=${CONTAINER_GID}"
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --pids-limit="$PIDS_LIMIT"
    --env "HOME=${CONTAINER_HOME}"
    --env "USER=${CONTAINER_USER}"
    --env "XDG_CONFIG_HOME=${CONTAINER_HOME}/.config"
    --env "XDG_DATA_HOME=${CONTAINER_HOME}/.local/share"
    --env "XDG_CACHE_HOME=${CONTAINER_HOME}/.cache"
    --env "XDG_STATE_HOME=${CONTAINER_HOME}/.local/state"
    --env "XDG_BIN_HOME=${CONTAINER_HOME}/.local/bin"
    --volume "${HOST_WORKSPACE}:${CONTAINER_START_DIR}:rw"
    --volume "${AGENT_VOLUME}:${CONTAINER_HOME}/.pi/agent:rw"
    --workdir "$CONTAINER_START_DIR"
)

[[ -n "$MEMORY" ]] && RUN_ARGS+=(--memory "$MEMORY")
[[ -n "$CPUS" ]] && RUN_ARGS+=(--cpus "$CPUS")
[[ "$NETWORK_MODE" == "none" ]] && RUN_ARGS+=(--network=none --env PI_OFFLINE=1)

for mount in "${VALIDATED_MOUNTS[@]}"; do
    RUN_ARGS+=(--volume "$mount")
done

if [[ -n "$ENV_FILE" ]]; then
    [[ -r "$ENV_FILE" ]] || { err "environment file is not readable: $ENV_FILE"; exit 1; }
    RUN_ARGS+=(--env-file "$ENV_FILE")
fi

for var in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY; do
    [[ -n "${!var:-}" ]] && RUN_ARGS+=(--env "$var")
done

log "Starting Pi sandbox"
echo "    image:     $IMAGE"
echo "    start dir:  $HOST_WORKSPACE -> $CONTAINER_START_DIR"
echo "    state:     $AGENT_VOLUME"
echo "    network:   $NETWORK_MODE"

if (( SHELL_MODE )); then
    run_cmd podman run "${RUN_ARGS[@]}" --entrypoint /bin/bash "$IMAGE"
else
    run_cmd podman run "${RUN_ARGS[@]}" "$IMAGE" "${PI_ARGS[@]}"
fi
